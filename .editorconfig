# Matches the Prettier configuration in .prettierrc, so an editor and a
# `npm run format` do not disagree about a file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown gives meaning to trailing spaces, so leave them alone.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[package-lock.json]
insert_final_newline = unset
